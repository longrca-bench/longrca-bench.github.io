{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://longrca-bench.github.io/data/leaderboard.schema.json",
  "title": "LongRCA Bench leaderboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "evaluation_split",
    "generated_at",
    "paper_url",
    "dataset_url",
    "sort",
    "benchmark_slices",
    "results"
  ],
  "properties": {
    "schema_version": { "const": "1.3.0" },
    "benchmark": { "const": "LongRCA Bench" },
    "evaluation_split": { "const": "public" },
    "generated_at": { "type": "string", "format": "date" },
    "paper_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "dataset_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction"],
      "properties": {
        "metric": { "const": "root_exact" },
        "direction": { "const": "descending" }
      }
    },
    "benchmark_slices": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/sweSlice" },
        { "$ref": "#/$defs/terminalSlice" },
        { "$ref": "#/$defs/travelSlice" },
        { "$ref": "#/$defs/vitaSlice" },
        { "$ref": "#/$defs/webSlice" }
      ],
      "items": false
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 1140 },
    "sweSlice": {
      "const": { "id": "swe_bench_pro", "label": "SWE-bench Pro", "n": 128 }
    },
    "terminalSlice": {
      "const": { "id": "terminal_bench_2", "label": "Terminal-Bench 2", "n": 42 }
    },
    "travelSlice": {
      "const": { "id": "travelplanner", "label": "TravelPlanner", "n": 685 }
    },
    "vitaSlice": {
      "const": { "id": "vitabench", "label": "VitaBench", "n": 108 }
    },
    "webSlice": {
      "const": { "id": "webarena_verified", "label": "WebArena", "n": 177 }
    },
    "sliceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "root_exact_correct"],
      "properties": {
        "n": { "$ref": "#/$defs/count" },
        "root_exact_correct": { "$ref": "#/$defs/count" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "display_name",
        "citation_label",
        "model",
        "provider",
        "n",
        "role_correct",
        "root_exact_correct",
        "root_within_5_correct",
        "root_mae",
        "valid_step_n",
        "failed_n",
        "by_benchmark",
        "date",
        "status",
        "links"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "method": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "citation_label": { "type": "string", "minLength": 1 },
        "model": { "const": "DeepSeek-V4-Flash" },
        "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "n": { "const": 1140 },
        "role_correct": { "$ref": "#/$defs/count" },
        "root_exact_correct": { "$ref": "#/$defs/count" },
        "root_within_5_correct": { "$ref": "#/$defs/count" },
        "root_mae": { "type": "number", "minimum": 0 },
        "valid_step_n": { "$ref": "#/$defs/count" },
        "failed_n": { "$ref": "#/$defs/count" },
        "by_benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "swe_bench_pro",
            "terminal_bench_2",
            "travelplanner",
            "vitabench",
            "webarena_verified"
          ],
          "properties": {
            "swe_bench_pro": { "$ref": "#/$defs/sliceResult" },
            "terminal_bench_2": { "$ref": "#/$defs/sliceResult" },
            "travelplanner": { "$ref": "#/$defs/sliceResult" },
            "vitabench": { "$ref": "#/$defs/sliceResult" },
            "webarena_verified": { "$ref": "#/$defs/sliceResult" }
          }
        },
        "date": { "type": "string", "format": "date" },
        "status": { "const": "Paper Result" },
        "links": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
